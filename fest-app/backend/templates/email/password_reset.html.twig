{% extends 'email/base.html.twig' %}

{% block subject %}Recuperación de contraseña{% endblock %}

{% block content %}
<h2 style="margin: 0 0 16px; font-size: 22px; color: #1e1b4b;">
  Hola, {{ nombre }}
</h2>

<p style="margin: 0 0 20px; font-size: 15px; line-height: 1.6; color: #374151;">
  Hemos recibido una solicitud para recuperar la contraseña de tu cuenta.
  Si no has sido tú, ignora este mensaje y tu contraseña no cambiará.
</p>

<p style="margin: 0 0 28px; font-size: 15px; line-height: 1.6; color: #374151;">
  Haz clic en el botón para establecer una nueva contraseña.<br>
  <strong>El enlace es válido durante {{ expiresInMinutes }} minutos.</strong>
</p>

<div style="text-align: center; margin: 0 0 32px;">
  <a href="{{ resetUrl }}"
     style="display: inline-block; padding: 14px 32px; background: #4f46e5;
            color: #ffffff; text-decoration: none; border-radius: 8px;
            font-weight: 700; font-size: 16px; letter-spacing: 0.02em;">
    Restablecer contraseña
  </a>
</div>

<p style="margin: 0 0 8px; font-size: 13px; color: #6b7280;">
  Si el botón no funciona, copia y pega esta URL en tu navegador:
</p>
<p style="margin: 0; font-size: 12px; color: #9ca3af; word-break: break-all;">
  {{ resetUrl }}
</p>
{% endblock %}

