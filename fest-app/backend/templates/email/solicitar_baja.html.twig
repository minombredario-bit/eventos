{% extends 'email/base.html.twig' %}

{% block email_title %}Solicitud de baja / cambio en grupo familiar{% endblock %}
{% block email_preheader %}Se ha recibido una solicitud de baja o cambio en grupo familiar{% endblock %}
{% block email_heading %}Solicitud de baja / cambio en grupo familiar{% endblock %}

{% block content %}
    <p style="margin:0 0 18px;">Se ha recibido una solicitud desde la cuenta de <strong>{{ requestor }}</strong> &lt;{{ requestor_email }}&gt;.</p>

    <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="margin:0 0 24px; border-collapse:separate; border-spacing:0; background:#f8fafc; border:1px solid #e5e7eb; border-radius:18px; overflow:hidden;">
        <tr>
            <td style="padding:18px 20px; font-size:14px; line-height:1.75; color:#334155;">
                <div style="margin-bottom:8px;"><strong>Acción solicitada:</strong> {{ action }}</div>
                {% if reason %}
                    <div style="margin-bottom:8px;"><strong>Motivo:</strong> {{ reason }}</div>
                {% endif %}

                <div style="margin-top:14px; font-weight:700; color:#111827;">Usuarios afectados:</div>
                {% if targets is empty %}
                    <div style="margin-top:6px; color:#6b7280;">No se han procesado usuarios.</div>
                {% else %}
                    <div style="margin-top:10px;">
                        {% for t in targets %}
                            <div style="padding:8px 0; border-top:1px solid #e5e7eb;">ID: {{ t.id }} — Acción: {{ t.action }}</div>
                        {% endfor %}
                    </div>
                {% endif %}
            </td>
        </tr>
    </table>

    <p style="margin:0;">Si tienes dudas o necesitas confirmar la solicitud, responde a este email o accede al panel de administración de la entidad.</p>
{% endblock %}

