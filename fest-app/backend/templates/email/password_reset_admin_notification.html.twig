{# templates/email/password_reset_admin_notification.html.twig #}
{% extends "email/base.html.twig" %}

{% block title %}Solicitud de restablecimiento de contraseña{% endblock %}

{% block content %}
<p>Hola,</p>

<p>El usuario <strong>{{ usuarioNombre }} {{ usuarioApellidos }}</strong> ha solicitado restablecer su contraseña.</p>

<h3>Información del usuario:</h3>
<ul>
    <li><strong>Nombre:</strong> {{ usuarioNombre }} {{ usuarioApellidos }}</li>
    <li><strong>Email:</strong> {{ usuarioEmail }}</li>
    <li><strong>Documento de identidad:</strong> {{ usuarioDocumento }}</li>
    <li><strong>Entidad:</strong> {{ entidadNombre }}</li>
</ul>

<h3>Instrucciones:</h3>
<p>{{ instrucciones }}</p>

<p>Puedes acceder a la administración de usuarios para:</p>
<ul>
    <li>Establecer una contraseña temporal</li>
    <li>Proporcionar las instrucciones de reset de contraseña al usuario por otro medio</li>
    <li>Sugerir al usuario que agregue un email a su perfil para futuras recuperaciones</li>
</ul>

<p>Saludos,<br>
Equipo de Festapp</p>
{% endblock %}

